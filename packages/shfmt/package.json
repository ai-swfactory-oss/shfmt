{
  "name": "@ai-swfactory-oss/shfmt",
  "description": "shfmt (mvdan/sh), the shell parser, formatter and interpreter, as the unmodified native upstream binary per platform",
  "keywords": [
    "shfmt",
    "shell",
    "bash",
    "formatter",
    "parser"
  ],
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/shfmt.git",
    "directory": "packages/shfmt"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  }
}
